 if(e.target.closest('[data-sp],[data-del],[data-open]')){rvClick(e,()=>render());return}
 const n=e.target.closest('.nav');
 if(n){const st=n.parentNode.querySelector('.strip');st.scrollBy({left:(n.classList.contains('l')?-1:1)*st.clientWidth*.8,behavior:'smooth'});return}
 const a=e.target.closest('[data-add]');
 if(a){const v=$('q').value.trim(),b={id:'c'+Date.now(),t:v,a:'Bilinmeyen yazar',y:'',g:a.dataset.add};S.custom.push(b);save();open(b.id);return}
 const i=e.target.closest('.pt');if(i)open(i.dataset.id)};
function open(id){
 const b=[...S.custom,...B,...Object.values(pool),...Object.values(extra)].find(x=>x.id===id),m=S.my[id]=S.my[id]||{r:0,n:'',done:false};
 if(b.ol){const i=S.custom.findIndex(x=>x.id===id);if(i<0)S.custom.push(b);else S.custom[i]=b;save()}
 const d=$('detail'),p=$('paper');d.hidden=false;d.scrollTop=0;
 const paint=()=>{const g=G[b.g],th=themeOf(b,g);d.style.setProperty('--bg',th.bg);d.style.setProperty('--acc',th.c);figs(b,g)};
 const draw=()=>{const g=G[b.g];
  p.innerHTML=`${b.cv?`<img src="https://covers.openlibrary.org/b/id/${b.cv}-L.jpg" alt="" style="float:right;width:96px;margin:0 0 10px 12px;border-radius:6px;box-shadow:0 6px 18px rgba(0,0,0,.5)">`:''}<span class="tag" style="--c:${g.c}">${g.n}</span>${m.done?'<span class="stamp">OKUNDU</span>':''}<h2>${esc(b.t)}</h2><div style="opacity:.75;margin-bottom:12px">${esc(b.a)}${b.y?' · '+b.y:''}${b.ot&&b.ot!==b.t?`<br><small>Özgün adı: ${esc(b.ot)}</small>`:''}</div>
 ${b.desc?`<p style="line-height:1.5;font-size:.9rem;clear:both">${esc(b.desc)}<br><small>— Open Library</small></p>`:''}
 <div class="stars" id="st">${[1,2,3,4,5].map(n=>`<button class="star ${n<=m.r?'on':''}" data-n="${n}" aria-label="${n} yıldız">★</button>`).join('')}<small>${m.r?m.r+' / 5':'Puan ver'}</small></div>
 <div class="row"><button class="btn ${m.done?'on':''}" id="dn">${m.done?'✓ Okudum':'Okudum olarak işaretle'}</button></div>
 <label>Notlarım</label><textarea id="nt" placeholder="Bu kitap hakkında ne düşünüyorsun?">${esc(m.n||'')}</textarea>`;
  $('st').onclick=e=>{const x=e.target.closest('.star');if(!x)return;const n=+x.dataset.n;m.r=(m.r===n)?0:n;save();draw()};
  $('dn').onclick=()=>{m.done=!m.done;save();draw()};
  $('nt').oninput=e=>{m.n=e.target.value;save()}};
 paint();draw();stopRev();mountReviews(b);
 if(b.ol&&b.wk&&!b.en)enrich(b).then(ok=>{if(ok&&!d.hidden){paint();draw()}})}
const COV={'Kürk Mantolu Madonna':'Madonna in a Fur Coat','Tutunamayanlar':'The Disconnected','Anna Karenina':'Anna Karenina','Dune':'Dune','Frankenstein':'Frankenstein','Doğu Ekspresinde Cinayet':'Murder on the Orient Express','Kızıl Dosya':'A Study in Scarlet','Ejderha Dövmeli Kız':'The Girl with the Dragon Tattoo','Da Vinci Şifresi':'The Da Vinci Code','Gülün Adı':'The Name of the Rose','Gurur ve Önyargı':'Pride and Prejudice','Harry Potter ve Felsefe Taşı':"Harry Potter and the Philosopher's Stone",'Hobbit':'The Hobbit','Yüzüklerin Efendisi':'The Fellowship of the Ring','1984':'Nineteen Eighty-Four','Cesur Yeni Dünya':'Brave New World','Vakıf':'Foundation','Drakula':'Dracula','Cinnet':'The Shining','Suç ve Ceza':'Crime and Punishment','Bülbülü Öldürmek':'To Kill a Mockingbird','Benim Adım Kırmızı':'My Name Is Red','Sefiller':'Les Misérables'};
const HQ={polisiye:'subject:(mystery OR detective OR crime OR thriller)',ask:'subject:(romance OR "love stories")',fantastik:'subject:(fantasy OR wizards OR dragons)',bilimkurgu:'subject:("science fiction" OR dystopia)',korku:'subject:(horror OR vampires OR ghosts)',klasik:'subject:("classic literature" OR "russian fiction" OR "turkish fiction")',tarih:'subject:("historical fiction" OR "ottoman empire")'};
const coverImg=b=>`<img loading="lazy" onerror="this.remove()" src="https://covers.openlibrary.org/b/id/${b.cv}-M.jpg?default=false" alt="">`;
function paintCover(b){document.querySelectorAll('.pt[data-id="'+b.id+'"] .po').forEach(po=>{if(po.querySelector('img'))return;const bd=po.querySelector('.bd');bd?bd.insertAdjacentHTML('beforebegin',coverImg(b)):po.insertAdjacentHTML('beforeend',coverImg(b))})}
async function coverFor(b){const en=COV[b.t]||b.t,hit=(q,loose)=>fetch('https://openlibrary.org/search.json?limit=8&fields=cover_i,title&'+q).then(r=>r.json()).then(j=>{const d=(j.docs||[]).find(x=>x.cover_i&&(!loose||tk(x.title).slice(0,4)===tk(en).slice(0,4)||tk(x.title).slice(0,4)===tk(b.t).slice(0,4)));return d?d.cover_i:0});
 const qs=[['title='+encodeURIComponent(en)+'&author='+encodeURIComponent(b.a),0],['title='+encodeURIComponent(en),1],['title='+encodeURIComponent(b.t)+'&author='+encodeURIComponent(b.a),1],['q='+encodeURIComponent(b.t+' '+b.a),1]];
 let net=false;
 for(const [q,l] of qs){try{const c=await hit(q,l);if(c)return c}catch(e){net=true;await new Promise(r=>setTimeout(r,700))}}
 return net?null:0}
async function fillCovers(){const todo=B.filter(b=>!b.cv);
 for(let i=0;i<todo.length;i+=3){await new Promise(r=>setTimeout(r,250));await Promise.all(todo.slice(i,i+3).map(async b=>{const c=await coverFor(b);if(c){b.cv=c;(S.cv=S.cv||{})[b.id]=c;paintCover(b)}}));save()}}
async function loadHome(){
 await Promise.all(Object.keys(HQ).map(async k=>{
  try{const u='https://openlibrary.org/search.json?limit=40&sort=readinglog&offset='+(Math.floor(Math.random()*3)*20)+'&lang=tur&fields=key,title,author_name,first_publish_year,cover_i,subject,editions,editions.title,editions.language&q='+encodeURIComponent(HQ[k]+' AND language:tur');
   const j=await (await fetch(u)).json();
   const l=(j.docs||[]).filter(d=>d.key&&d.cover_i).map(d=>{const [t,tr]=trT(d);return {id:'ol'+d.key.split('/').pop(),t,tr,ot:d.title,a:(d.author_name||['Bilinmeyen yazar'])[0],y:d.first_publish_year||'',g:k,cv:d.cover_i,wk:d.key,ol:1,sub:(d.subject||[]).slice(0,25)}}).filter(x=>x.tr&&tk(x.t).length>2&&(g2=>g2===k||g2==='klasik')(genreOf(x.ot+' '+x.t,x.a,x.sub.join(' '))));
   l.forEach(x=>{if(!pool[x.id])pool[x.id]=x});live[k]=l}catch(e){}}));
 {const top=[];for(let i=0;i<6;i++)Object.keys(G).forEach(k=>{if(live[k]&&live[k][i])top.push(live[k][i])});feat=dedupe(shuf(B).slice(0,8).concat(top))}loadingHome=false;
 if(tab==='k'&&!$('q').value&&$('detail').hidden)render()}
KW.push(...[[/kar\b|buz|snow|winter|\bice\b/,'❄️'],[/deniz|gemi|\bsea\b|ocean|\bship/,'🌊'],[/orman|forest|ağaç/,'🌲'],[/çöl|desert/,'🏜️'],[/savaş|\bwar\b|battle|asker/,'⚔️'],[/cinayet|murder|katil|killer|dedektif|polis/,'🔎'],[/aşk|\blove\b|sevgi/,'💞'],[/büyü|sihir|magic|wizard|cadı|witch/,'🪄'],[/uzay|space|gezegen|planet|yıldız/,'🪐'],[/hayalet|ghost|korku|horror/,'👻'],[/vampir|vampire|drakula/,'🧛'],[/şato|castle|kale/,'🏰'],[/tren|train|ekspres/,'🚂'],[/mektup|letter/,'✉️'],[/müzik|music|keman/,'🎻'],[/ressam|painter|nakış|minyatür/,'🖌️'],[/kütüphane|library/,'📚'],[/saat|zaman|\btime\b|clock/,'⏳'],[/ateş|\bfire\b|alev/,'🔥'],[/çiçek|\bgül|\brose\b|flower|garden|bahçe/,'🌹'],[/kral|kraliçe|\bking\b|\bqueen\b|prens|sultan|padişah/,'👑'],[/robot|makine|yapay/,'🤖'],[/ejderha|dragon/,'🐉'],[/\bdağ|mountain/,'⛰️'],[/kedi|\bcat\b/,'🐈'],[/köpek|\bdog\b/,'🐕'],[/atatürk|cumhuriyet|republic/,'🇹🇷'],[/istanbul|osmanlı|ottoman/,'🕌'],[/yağmur|\brain\b/,'☔'],[/zehir|poison/,'🧪'],[/hapis|prison|zindan|cezaevi/,'⛓️'],[/okul|school|öğrenci/,'🎒'],[/hırsız|thief|heist|soygun/,'💰']]);
const MOODS=[[/sea\b|ocean|ship|voyage|island|deniz|gemi|⛵|🏝️|🌊/,'#16323f'],[/desert|sand|çöl|🏜️|🪱/,'#3d3018'],[/snow|\bice\b|winter|\bkar\b|buz|❄️/,'#1f2e3d'],[/forest|jungle|orman|🌲|🌳/,'#1b2f21'],[/space|planet|galaxy|uzay|🪐|🚀|🌌/,'#11172e'],[/\bwar\b|battle|soldier|savaş|⚔️|blood|🩸/,'#3b1b1b'],[/night|moon|ghost|haunt|gece|🌙|👻/,'#1a1730'],[/love|romance|\brose\b|aşk|💌|🌹|💞/,'#3a2029'],[/castle|medieval|şato|🏰|⛪/,'#2f2733'],[/\bcity\b|london|paris|istanbul|şehir|🏙️|🌃/,'#232a33'],[/volcano|\bfire\b|ateş|🌋|🔥/,'#3d1f12'],[/train|railway|tren|🚂/,'#2a2a22']];
function moodBg(b,g){const t=((b.sub||[]).join(' ')+' '+b.t+' '+(b.ot||'')+' '+(b.al||'')+' '+(b.desc||'')+' '+fxFor(b).join(' ')).toLowerCase();
 for(const [r,c] of MOODS)if(r.test(t))return `linear-gradient(165deg,${c},${g.bg} 75%)`;return g.bg}
const SE={ilkbahar:['flower','flower','leaf'],yaz:['sun','sun','star'],sonbahar:['leaf','leaf','tree'],kis:['snow','snow','snow']};
function season(k){S.season=k||'';save();document.documentElement.dataset.season=S.season;
 document.querySelectorAll('.sbtn').forEach(x=>x.classList.toggle('on',x.dataset.s===S.season));
 const f=$('sea');f.innerHTML='';if(!S.season)return;
 for(let i=0;i<18;i++){const e=document.createElement('span');e.innerHTML=ic(SE[S.season][i%3],14+Math.random()*14);e.style.cssText=`left:${Math.random()*100}%;animation-duration:${9+Math.random()*10}s;animation-delay:-${Math.random()*14}s`;f.appendChild(e)}}
const ago=ts=>{const m=Math.round((Date.now()-ts)/60000);return m<1?'az önce':m<60?m+' dk önce':m<1440?Math.round(m/60)+' sa önce':new Date(ts).toLocaleDateString('tr-TR')};
function avatar(n){let h=0;for(const c of n)h=(h*31+c.charCodeAt(0))%360;return `<span class="av" style="background:hsl(${h} 40% 36%)">${esc((n||'O')[0].toUpperCase())}</span>`}
function bookIdFor(r){const loc=all().find(x=>tk(x.t)===tk(r.t));if(loc)return loc.id;const id='f_'+r.bk;extra[id]={id,t:r.t,a:r.a||'',y:r.y||'',cv:r.cv,g:G[r.g]?r.g:'klasik'};return id}
function rvCard(r,cp){const g=G[r.g]||G.klasik,nm=r.name||'Okur',tx=esc(r.text);
 return `<article class="rv${cp?' cp':''}"><div class="rvh"><div class="rvtl"><a class="rvt" data-open="${esc(bookIdFor(r))}">${esc(r.t)}</a> <small>${r.y||''}</small></div><div class="rvu">${esc(nm)} ${avatar(nm)}</div></div>
 ${r.r||r.heart?`<div class="rvs"><span class="on">${'★'.repeat(r.r||0)}</span><span class="off">${'★'.repeat(5-(r.r||0))}</span>${r.heart?' <span class="hr">♥</span>':''}</div>`:''}
 <div class="rvb"><div class="rvp" style="--c:${g.c};--b:${g.bg}">${r.cv?`<img onerror="this.remove()" src="https://covers.openlibrary.org/b/id/${r.cv}-M.jpg?default=false" alt="">`:`<span class="rvi">${ic((GI[r.g]||GI.klasik)[0],24)}</span>`}</div><div class="rvx">${r.spoiler?`<div class="spo" data-sp>Yorum spoiler içerebilir.<br><u>Göstermek için dokun</u></div><div class="rvtxt" hidden>${tx}</div>`:`<div class="rvtxt">${tx}</div>`}<small>${ago(r.ts)}${r.uid===S.uid?` · <button class="rx" data-del="${esc(r.id)}">sil</button>`:''}</small></div></div></article>`}
async function rvClick(e,after){
 const sp=e.target.closest('[data-sp]');if(sp){sp.hidden=true;sp.nextElementSibling.hidden=false;return}
 const d=e.target.closest('[data-del]');
 if(d){const id=d.dataset.del,db=await dbReady;try{if(db)await db.collection('feed').doc(id).delete();else{S.rev=S.rev.filter(r=>r.id!==id);save();feedRows=feedRows.filter(r=>r.id!==id);after&&after()}}catch(x){}return}
 const o=e.target.closest('[data-open]');if(o)open(o.dataset.open)}
async function startFeed(){if(feedUn)return;const db=await dbReady;
 if(db){try{feedUn=db.collection('feed').orderBy('ts','desc').limit(40).onSnapshot(sn=>{feedRows=sn.docs.map(d=>Object.assign({id:d.id},d.data()));if(tab==='y')render()},()=>{})}catch(e){}}
 else{feedRows=S.rev.slice().sort((a,b)=>b.ts-a.ts);if(tab==='y')render()}}
function mountReviews(b){
 const box=$('rev'),key='k_'+tk(b.t);let un=null,rows=[],dbw=null,rr=(S.my[b.id]||{}).r||0,hh=false;
 S.uid=S.uid||Math.random().toString(36).slice(2,10);
 const list=()=>{rows.sort((x,y)=>y.ts-x.ts);$('rl').innerHTML=rows.length?rows.map(r=>rvCard(r,1)).join(''):'<div class="note">Henüz yorum yok. İlk yorumu sen yaz.</div>'};
 const form=()=>{$('rfs').innerHTML=[1,2,3,4,5].map(n=>`<button type="button" class="star ${n<=rr?'on':''}" data-n="${n}">★</button>`).join('')+`<button type="button" class="hbtn ${hh?'on':''}" id="rh" title="Beğendim">♥</button>`};
 box.innerHTML=`<h3>Okur yorumları</h3><div class="note" id="rnote"></div><input id="rn" class="rin" maxlength="30" placeholder="Adın" value="${esc(S.nick||'')}"><div class="stars" id="rfs"></div><textarea id="rt" maxlength="600" placeholder="Bu kitap hakkında ne düşünüyorsun? Yorumunu herkes görebilir."></textarea><label class="spl"><input type="checkbox" id="rsp"> Spoiler içeriyor</label><div class="row"><button class="btn on" id="rs">Yorumu paylaş</button></div><div id="rl"></div>`;
 form();
 $('rfs').onclick=e=>{const x=e.target.closest('.star');if(x){const n=+x.dataset.n;rr=rr===n?0:n;form();return}if(e.target.closest('#rh')){hh=!hh;form()}};
 stopRev=()=>{if(un){un();un=null}};
 dbReady.then(db=>{dbw=db;
  $('rnote').textContent=db?'Bu kitabın yorumlarını sayfayı açan herkes görebilir.':'Yorumlar şimdilik yalnızca bu cihazda saklanıyor. Herkesle paylaşılan yorumlar yayınlanan sürümde çalışır.';
  if(db){try{un=db.collection('feed').where('bk','==',key).limit(50).onSnapshot(sn=>{rows=sn.docs.map(d=>Object.assign({id:d.id},d.data()));list()},()=>{$('rnote').textContent='Yorumlar yüklenemedi.'})}catch(e){}}
  else{rows=S.rev.filter(r=>r.bk===key);list()}});
 $('rs').onclick=async()=>{const text=$('rt').value.trim();if(text.length<2)return;S.nick=$('rn').value.trim().slice(0,30);
  const row={bk:key,t:b.t,a:b.a||'',y:b.y||'',cv:b.cv||0,g:b.g,name:S.nick||'Okur',text:text.slice(0,600),ts:Date.now(),uid:S.uid,r:rr,heart:hh,spoiler:$('rsp').checked};
  try{if(dbw){await dbw.collection('feed').add(row)}
   else{const x=Object.assign({id:'l'+row.ts},row);S.rev.push(x);rows.push(x);list();feedRows=S.rev.slice().sort((a,c)=>c.ts-a.ts)}
   $('rt').value='';$('rsp').checked=false;save()}
  catch(e){$('rnote').textContent=(e&&e.code==='invalid_argument')?'Yorum yazabilmek için bu sayfada katılımcı (Contributor) yetkisi gerekiyor.':'Yorum gönderilemedi, tekrar dene.'}};
 $('rl').onclick=e=>rvClick(e,()=>{rows=S.rev.filter(r=>r.bk===key);list()})}
$('back').onclick=()=>{stopRev();$('detail').hidden=true;render()};
if(!Array.isArray(S.rev))S.rev=[];
B.forEach(b=>{if(S.cv&&S.cv[b.id])b.cv=S.cv[b.id]});
document.querySelectorAll('.sbtn').forEach(x=>{x.innerHTML=ic({ilkbahar:'flower',yaz:'sun',sonbahar:'leaf',kis:'snow'}[x.dataset.s],20)});
document.querySelectorAll('.sbtn').forEach(x=>x.onclick=()=>season(S.season===x.dataset.s?'':x.dataset.s));
season(S.season||'');
render();fillCovers();loadHome();
</script>
