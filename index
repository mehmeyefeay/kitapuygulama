['1984','George Orwell',1949,'bilimkurgu','bin dokuz yuz seksen dort'],
['Dune','Frank Herbert',1965,'bilimkurgu','çöl gezegeni'],
['Cesur Yeni Dünya','Aldous Huxley',1932,'bilimkurgu','brave new world'],
['Vakıf','Isaac Asimov',1951,'bilimkurgu','foundation'],
['Drakula','Bram Stoker',1897,'korku','dracula'],
['Frankenstein','Mary Shelley',1818,'korku',''],
['Cinnet','Stephen King',1977,'korku','the shining parlayan'],
['Suç ve Ceza','Fyodor Dostoyevski',1866,'klasik','crime and punishment'],
['Tutunamayanlar','Oğuz Atay',1971,'klasik',''],
['Bülbülü Öldürmek','Harper Lee',1960,'klasik','to kill a mockingbird'],
['Benim Adım Kırmızı','Orhan Pamuk',1998,'tarih','my name is red'],
