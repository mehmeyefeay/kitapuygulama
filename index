['Kızıl Dosya','Arthur Conan Doyle',1887,'polisiye','sherlock holmes study in scarlet'],
['Ejderha Dövmeli Kız','Stieg Larsson',2005,'polisiye','girl with the dragon tattoo'],
['Da Vinci Şifresi','Dan Brown',2003,'polisiye','da vinci code'],
['Gülün Adı','Umberto Eco',1980,'polisiye','name of the rose'],
['Gurur ve Önyargı','Jane Austen',1813,'ask','pride and prejudice gurur ve onyargi'],
['Kürk Mantolu Madonna','Sabahattin Ali',1943,'ask',''],
['Anna Karenina','Lev Tolstoy',1877,'ask',''],
['Harry Potter ve Felsefe Taşı','J. K. Rowling',1997,'fantastik','harry potter philosopher stone'],
