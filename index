].map((b,i)=>({id:'b'+i,t:b[0],a:b[1],y:b[2],g:b[3],al:b[4]}));
const FX={"Doğu Ekspresinde Cinayet": "🚂 ❄️ 🎩 🔎 🗝️ 🛤️", "Kızıl Dosya": "🔎 🎻 🌫️ 🎩 📰 🏚️", "Ejderha Dövmeli Kız": "🐉 💻 🏝️ 📰 🔎 ❄️", "Da Vinci Şifresi": "🖼️ 🗝️ 🏛️ 🔐 📜 🕯️", "Gülün Adı": "📚 🕯️ ⛪ 🔎 📜 🗝️", "Gurur ve Önyargı": "💌 💃 🏡 🐎 🌹 🫖", "Kürk Mantolu Madonna": "🖼️ 🧥 💌 🚂 🌹 🕰️", "Anna Karenina": "🚂 ❄️ 💃 💌 🐎 🌹", "Harry Potter ve Felsefe Taşı": "🧙 ⚡ 🦉 🪄 🏰 🧹 🎬 🎞️ 🍿", "Hobbit": "🐉 🏔️ 💍 🧙 🏰 🍄", "Yüzüklerin Efendisi": "💍 🧙 🌋 🏔️ 🏹 🐎", "1984": "📺 👀 🐀 🏭 📖 🚫", "Dune": "🏜️ 🪱 🪐 ☀️ 💧 🚀", "Cesur Yeni Dünya": "💊 🧪 🏭 🍼 🚁 🤖", "Vakıf": "🪐 🚀 🌌 📡 🤖 ⭐", "Drakula": "🧛 🦇 🏰 🌙 🩸 🐺", "Frankenstein": "⚡ 🧪 🌩️ 🏚️ 🧟 🕯️", "Cinnet": "🏨 ❄️ 👻 🗝️ 🕯️ 🌲", "Suç ve Ceza": "🪙 ⛪ 🌃 🕯️ 📖 ❄️", "Tutunamayanlar": "📖 🏙️ 🕰️ ☕ 🖋️ 🌃", "Bülbülü Öldürmek": "🐦 🌳 🏡 ⚖️ 📚 🌾", "Benim Adım Kırmızı": "🖌️ 🎨 🕌 📜 🌹 🏺", "Sefiller": "🕯️ 🍞 ⚖️ 🚩 🌉 ⛓️", "Nutuk": "🇹🇷 ⚔️ 🐎 📜 🌅 ⭐"};
B.forEach(b=>{if(FX[b.t])b.fx=FX[b.t].split(' ')});
const fxFor=b=>b.fx||[];
const norm=s=>s.toLocaleLowerCase('tr').replace(/ı/g,'i').replace(/ö/g,'o').replace(/ü/g,'u').replace(/ş/g,'s').replace(/ç/g,'c').replace(/ğ/g,'g').trim();
let S={my:{},custom:[]},tab='k';
try{const x=localStorage.getItem('kitapkutusu');if(x)S=JSON.parse(x)}catch(e){}
const save=()=>{try{localStorage.setItem('kitapkutusu',JSON.stringify(S))}catch(e){}};
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let pool={},remote=null,status='',tm,live={},feat=[],loadingHome=true,stopRev=()=>{},feedRows=[],feedUn=null,extra={};
const dbReady=(async()=>{try{return window.claude&&claude.use?await claude.use('db'):null}catch(e){return null}})();
const shuf=a=>a.map(x=>[Math.random(),x]).sort((p,q)=>p[0]-q[0]).map(x=>x[1]);
const tk=x=>norm(x).replace(/[^a-z0-9]/g,'');
function dedupe(l){const seen=new Set(),o=[];for(const b of l){const k=tk(b.t);if(!k||seen.has(k))continue;seen.add(k);o.push(b)}return o}
const all=()=>dedupe(S.custom.concat(B,Object.values(pool)));
const AU=[[/rowling|tolkien|c\. ?s\. lewis|sapkowski|george r\. ?r\. martin/i,'fantastik'],[/christie|conan doyle|simenon|stieg larsson|dan brown|umberto eco|chandler|hammett/i,'polisiye'],[/stephen king|bram stoker|mary shelley|lovecraft|edgar allan poe/i,'korku'],[/asimov|frank herbert|orwell|huxley|bradbury|philip k|jules verne|h\. ?g\. wells/i,'bilimkurgu'],[/austen|bront|nicholas sparks|sabahattin ali/i,'ask'],[/dostoy|tolstoy|tolstoi|oğuz atay|victor hugo|kafka|camus|harper lee/i,'klasik']];
const TI=[[/harry potter|hobbit|narnia|lord of the rings|yüzüklerin/i,'fantastik'],[/sherlock|poirot|holmes/i,'polisiye']];
const W={polisiye:[[/detective/,3],[/mystery/,2],[/murder/,3],[/crime/,2],[/sleuth|whodunit/,3],[/investigat/,2],[/inspector|police|scotland yard/,2]],
fantastik:[[/wizard|sorcer|witch/,3],[/magic/,2],[/dragon/,3],[/fantasy/,3],[/hogwarts|middle.earth/,4],[/elf|elves|fairy/,2]],
ask:[[/romance/,3],[/love stor|love affair/,3],[/\blove\b/,1],[/courtship|marriage/,2]],
bilimkurgu:[[/science fiction/,4],[/dystopi/,3],[/space|planet|spaceship/,2],[/robot|artificial intelligence/,2],[/alien|time travel/,3]],
korku:[[/horror/,4],[/vampire|haunted|zombie/,3],[/ghost|monster|gothic|supernatural/,2]],
tarih:[[/historical fiction/,3],[/histor/,2],[/biograph/,2],[/empire|ottoman|medieval|revolution/,2],[/\bwar\b/,1]],
