bilimkurgu:{n:'Bilim Kurgu',c:'#6fc2d4',bg:'#1d2f38',f:['🚀','🛸','🪐','🤖','⭐','👽','🔭','🌌']},
korku:{n:'Korku',c:'#c9514e',bg:'#201b1c',f:['🦇','🕸️','🌙','👻','🕯️','🧛','💀','🪦']},
