const KW=[[/wizard|sorcer/,'🧙'],[/magic|spell/,'🪄'],[/\bowl/,'🦉'],[/broom|quidditch/,'🧹'],[/dragon/,'🐉'],[/castle|hogwarts|abbey/,'🏰'],[/train|express|railway/,'🚂'],[/detective|investigat|inspector|sleuth/,'🕵️'],[/murder|crime|killer/,'🔎'],[/letter|diary/,'✉️'],[/newspaper|journalist/,'📰'],[/\bkey\b|secret|code|cipher/,'🗝️'],[/ship|sea\b|island|voyage|ocean/,'⛵'],[/\bwar\b|soldier|battle/,'⚔️'],[/king|queen|crown|prince/,'👑'],[/love|romance|marri/,'💞'],[/rose|flower|garden/,'🌹'],[/\bring\b/,'💍'],[/space|planet|galaxy|star\b/,'🪐'],[/robot|machine|artificial/,'🤖'],[/alien/,'👽'],[/ghost|haunt/,'👻'],[/vampire|blood/,'🧛'],[/\bbats?\b/,'🦇'],[/moon|night/,'🌙'],[/forest|tree/,'🌲'],[/desert|sand/,'🏜️'],[/mountain/,'⛰️'],[/music|violin|song/,'🎻'],[/paint|artist/,'🎨'],[/librar|book/,'📚'],[/\bcat\b/,'🐈'],[/\bdog\b/,'🐕'],[/gold|treasure|money/,'💰'],[/poison/,'🧪'],[/clock|time/,'⏳'],[/city|london|paris|istanbul/,'🏙️'],[/church|monk|monaster/,'⛪'],[/rain/,'☔'],[/school|student/,'🎒']];
function genreOf(title,author,text){
 for(const [r,g] of TI)if(r.test(title))return g;
 for(const [r,g] of AU)if(r.test(author))return g;
 const t=(title+' '+text).toLowerCase();let best='klasik',bs=1;
