.rvx{flex:1;min-width:0;line-height:1.5}.rvtxt{white-space:pre-wrap;word-break:break-word}.rvx small{color:var(--mut);display:block;margin-top:4px}
.spo{background:var(--card);border-radius:8px;padding:18px;text-align:center;color:var(--mut);cursor:pointer;font-size:.9rem}
.rv.cp .rvp,.rv.cp .rvtl{display:none}.rv.cp .rvh{justify-content:flex-start}
.rvi{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;opacity:.85}.hbtn{background:none;border:0;font-size:1.7rem;color:#5b5348;cursor:pointer;margin-left:10px}.hbtn.on{color:#ff7a3d}.spl{display:block;margin:8px 0;color:var(--mut);font-size:.9rem}
</style>
</head>
