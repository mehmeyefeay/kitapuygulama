.rvh{display:flex;justify-content:space-between;gap:10px;align-items:center}
.rvt{font:700 1.15rem 'Playfair Display',Georgia,serif;color:var(--ink);cursor:pointer}.rvt:hover{color:var(--acc)}.rvh small{color:var(--mut)}
.rvu{display:flex;align-items:center;gap:8px;color:var(--mut);font-size:.9rem;white-space:nowrap}
.av{width:30px;height:30px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;color:#fff;font-size:.85rem;font-weight:600}
.rvs{margin:4px 0 8px;letter-spacing:1px}.rvs .on{color:var(--acc)}.rvs .off{color:#4b443b}.hr{color:#ff7a3d}
